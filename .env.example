# ── Database ──────────────────────────────────
# Local MySQL instance — database "sample-project" must exist
# Using root with no password (typical XAMPP/WAMP default)
CORS_ORIGIN="https://xxxxxxxxxxx.com"

DATABASE_URL="mysql://xxxx:xxxxxxxxx@localhost:3306/xxxxxxxxxxxxx?allowPublicKeyRetrieval=true"

# ── JWT ───────────────────────────────────────
JWT_SECRET="sample-project-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────
PORT=3002
NODE_ENV=production
